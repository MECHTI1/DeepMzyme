  "decisions": {
    "A2-D1": {
      "decision": "Each outer fold selects, among F2, F3, F4, F5 and F6, the family with the highest pooled inner seed-mean score on the primary metric (2 screening seeds x 4 inner folds), the learning rate per family by the same score, with a zero-recall harm guard against F2, a pre-declared simplicity order within 0.5 points of the maximum and no significance test. Controls are reported and never selectable. Historical rules stay replayable.",
      "owner": "science",
      "rules": [
        "A2-SEL-1",
        "A2-SEL-2",
        "A2-SEL-3",
        "A2-SEL-4",
        "A2-SEL-5",
        "A2-SEL-6",
        "A2-SEL-7"
      ]
    },
    "A2-D2": {
      "decision": "Primary metric: protein-level accuracy over the proteins of EC classes 1-6; class-7 proteins are excluded from the population and predictions into class 7 count wrong. Balanced accuracy over EC classes 1-6 is the first secondary metric. Co-primary populations, paired homology-cluster bootstrap, intersection-union against the R1 seed mean and ensemble, and Holm across the two populations are unchanged.",
      "owner": "science",
      "pre_data_rationale": "power_simulation.md",
      "rules": [
        "A2-MET-1",
        "A2-MET-2",
        "A2-MET-3",
        "A2-STAT-1"
      ]
    },
    "A2-D3": {
      "decision": "Candidate family F6: F5 whose whole-protein branch is first trained on the fold's full official training file (EC class = first EC digit; proteins with more than one EC class excluded), inner-validation proteins and their identity neighbours held out for inner fits; ESMC-300m whole-protein means built on the GPU pod; reverses Freeze-1 U3 for this branch only.",
      "owner": "science",
      "rules": [
        "A2-F6-1",
        "A2-F6-2",
        "A2-F6-3",
        "A2-F6-4",
        "A2-F6-5",
        "A2-F6-6",
        "A2-F6-7",
        "A2-F6-8"
      ]
    },
    "A2-D4": {
      "decision": "S2 keeps only the no-fit L9 adjustment; S3 is dropped; raw-distance RBF is the GVP default; 30 epochs fixed (cosine, terminal checkpoint); F1 runs in fold 0 only.",
      "owner": "science",
      "rules": [
        "A2-TRN-1",
        "A2-TRN-2",
        "A2-TRN-3",
        "A2-TRN-4",
        "A2-SEL-8",
        "A2-BUD"
      ]
    },
    "A2-D5": {
      "decision": "Futility stop after fold 0: continue to folds 1-4 only if the pre-declared projected probability that the final claim succeeds is at least 0.20; otherwise stop and close out as not shown to outperform. The -3-point gap record is descriptive.",
      "owner": "science",
      "rules": [
        "A2-FUT-1",
        "A2-FUT-2",
        "A2-FUT-3",
        "A2-FUT-4",
        "A2-FUT-5",
        "A2-FUT-6",
        "A2-FUT-7",
        "A2-FUT-8",
        "A2-FUT-9",
        "A2-GOV-7"
      ]
    },
    "A2-D6": {
      "decision": "Runpod only; G2 and fold 0 in one pod session.",
      "owner": "execution v5",
      "rules": []
    },
    "A2-D7": {
      "decision": "CLEAN fits and the ESM-1b and ESMC embeddings on the pod GPU with TF32 off.",
      "owner": "execution v5",
      "rules": [
        "A2-GOV-3",
        "A2-F6-4"
      ]
    },
    "A2-D8": {
      "decision": "A pre-approved fold-0 spending ceiling and a time-box of at most two further failed capacity windows; the amount is recorded in the execution v5 record before G2.",
      "owner": "execution v5",
